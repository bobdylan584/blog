- const { nav, owner, copyright } = theme.footer

// ===== Footer Navigation Blocks =====
if nav
  .footer-flex
    for block in nav
      .footer-flex-items(style=`${ block.width ? 'flex-grow:' + block.width : '' }`)
        for blockItem in block.content
          .footer-flex-item
            .footer-flex-title= blockItem.title
            .footer-flex-content
              for subitem in blockItem.item
                if subitem.html
                  div!= subitem.html
                else if subitem.url
                  a(href=url_for(subitem.url), target='_blank' title=subitem.title)= subitem.title
                else if subitem.title
                  div!= subitem.title

// ===== Copyright / Framework =====
.footer-other
  .footer-copyright
    if owner.enable
      - const currentYear = new Date().getFullYear()
      - const sinceYear = owner.since
      span.copyright
        if sinceYear && sinceYear != currentYear
          != `&copy;&nbsp;${sinceYear} - ${currentYear} By ${config.author}`
        else
          != `&copy;&nbsp;${currentYear} By ${config.author}`

    if copyright.enable
      - const v = copyright.version ? getVersion() : false
      span.framework-info
        if owner.enable && nav
          span.footer-separator |
        span= _p('footer.framework') + ' '
        a(href='https://hexo.io')= `Hexo${ v ? ' ' + v.hexo : '' }`
        span.footer-separator |
        span= _p('footer.theme') + ' '
        a(href='https://github.com/jerryc127/hexo-theme-butterfly')= `Butterfly${ v ? ' ' + v.theme : '' }`

// ========= Footer Webinfo (Horizontal Layout) =========
.footer-webinfo(style="text-align:center; color:#fff; margin-top:30px; font-size:16px;")
  .webinfo-row(style="display:flex; justify-content:center; gap:35px; flex-wrap:wrap; line-height:1.8em;")

    // Article Count
    if theme.aside.card_webinfo.post_count
      .webinfo-item
        span.item-name Article Count :
        span.item-count= site.posts.length

    // Unique Visitors (UV)
    if theme.busuanzi.site_uv
      .webinfo-item
        span.item-name Unique Visitors :
        span.item-count#busuanzi_value_site_uv
          i.fa-solid.fa-spinner.fa-spin

    // Page Views (PV)
    if theme.busuanzi.site_pv
      .webinfo-item
        span.item-name Page Views :
        span.item-count#busuanzi_value_site_pv
          i.fa-solid.fa-spinner.fa-spin

    // Last Update Time
    if theme.aside.card_webinfo.last_push_date
      .webinfo-item
        span.item-name Last Update :
        span.item-count#last-push-date(data-lastPushDate=date_xml(Date.now()))
          i.fa-solid.fa-spinner.fa-spin


// ====== Required JS (Busuanzi + Runtime) ======
script(async src="https://cdn.staticfile.org/busuanzi/2.3.0/busuanzi.pure.mini.js")
script(src= url_for('/js/runtime.js'))
script(src= url_for('/js/last-push-date.js'))

// ====== Coze Bot ======
script(src="https://lf-cdn.coze.cn/obj/unpkg/flow-platform/chat-app-sdk/1.2.0-beta.19/libs/cn/index.js")
script.
  window.addEventListener('DOMContentLoaded', function() {
    try {
      const client = new CozeWebSDK({
        bot_id: '7568773837157253158',
        title: '阿甘小助手',
        theme: 'light',
        bubble_text: '💬 问问阿甘？',
        bubble_icon: '🤖'
      });
      client.init();
    } catch (err) {
      console.error('Coze SDK 初始化失败：', err);
    }
  });

// ====== Styles for Webinfo ======
style.
  .webinfo-row {
    margin-top: 8px;
  }
  .webinfo-item {
    white-space: nowrap;
  }
  .item-name {
    font-weight: 600;
    margin-right: 4px;
  }
  .item-count {
    font-weight: 400;
  }
