extends includes/layout

block content
  .page
    h1.page-title 标签
    .tags-page

      // 样式：响应式布局
      style.
        .tag-grid {
          display: grid;
          grid-template-columns: repeat(3, 1fr);
          gap: 20px;
        }

        /* 平板 (<=1024px)：两列 */
        @media (max-width: 1024px) {
          .tag-grid {
            grid-template-columns: repeat(2, 1fr);
          }
        }

        /* 手机 (<=600px)：一列 */
        @media (max-width: 600px) {
          .tag-grid {
            grid-template-columns: repeat(1, 1fr);
          }
        }

        .tag-card img {
          width: 100%;
          border-radius: 8px;
          display: block;
        }

        .tag-card-title {
          font-size: 18px;
          font-weight: bold;
          margin-top: 10px;
          text-align: center;
          word-break: break-all;
        }

      .tag-grid
        each tag in site.tags.toArray().sort((a, b) => a.name.localeCompare(b.name))
          - var tagName = tag.name || '';
          - var count = tag.length || 0;
          - var encoded = encodeURIComponent(tagName);
          - var imgUrl = "https://picsum.photos/seed/" + encoded + "/300/180";
          - var tagUrl = url_for(tag.path || '');

          .tag-card
            a.tag-card-link(href=tagUrl)
              img(src=imgUrl, alt=tagName)

            .tag-card-title
              | #{tagName}(#{count} docs)
